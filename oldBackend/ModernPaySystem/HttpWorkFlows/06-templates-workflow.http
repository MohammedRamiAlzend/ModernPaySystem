### ═══════════════════════════════════════════════════════════
### TEMPLATES WORKFLOW - Transaction System
### Base Route: api/Templates
### ═══════════════════════════════════════════════════════════

@baseUrl = https://localhost:7010
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Q2jA5PJdQpjOZ9F0wnU_2GCorgyE4UQlEIGWMeofAmQ

@templateId = 00000000-0000-0000-0000-000000000000
@departmentId = 00000000-0000-0000-0000-000000000000
@userId = 00000000-0000-0000-0000-000000000000

### ──────────────────────────────────────────────
### 1. GET ALL TEMPLATES
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Templates
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 2. GET TEMPLATE BY ID
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Templates/{{templateId}}
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 3. GET TEMPLATE BY NAME
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Templates/by-name/RequestTemplate
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 4. CREATE TEMPLATE
### ──────────────────────────────────────────────
POST {{baseUrl}}/api/Templates
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "templateName": "Sample Request Template",
  "description": "Template for sample requests",
  "fields": []
}

### ──────────────────────────────────────────────
### 5. UPDATE TEMPLATE
### ──────────────────────────────────────────────
PUT {{baseUrl}}/api/Templates/{{templateId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "templateName": "Updated Template Name",
  "description": "Updated description"
}

### ──────────────────────────────────────────────
### 6. DELETE TEMPLATE
### ──────────────────────────────────────────────
DELETE {{baseUrl}}/api/Templates/{{templateId}}
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 7. GET TEMPLATE DEPARTMENT OWNERSHIPS
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Templates/{{templateId}}/ownerships
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 8. ADD DEPARTMENT OWNERSHIP
### ──────────────────────────────────────────────
POST {{baseUrl}}/api/Templates/{{templateId}}/ownerships
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "departmentId": "{{departmentId}}"
}

### ──────────────────────────────────────────────
### 9. REMOVE DEPARTMENT OWNERSHIP
### ──────────────────────────────────────────────
DELETE {{baseUrl}}/api/Templates/{{templateId}}/ownerships/{{departmentId}}
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 10. GET TEMPLATE USER OWNERSHIPS
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Templates/{{templateId}}/ownerships/user
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 11. ADD USER OWNERSHIP
### ──────────────────────────────────────────────
POST {{baseUrl}}/api/Templates/{{templateId}}/ownerships/user
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "{{userId}}"
}

### ──────────────────────────────────────────────
### 12. REMOVE USER OWNERSHIP
### ──────────────────────────────────────────────
DELETE {{baseUrl}}/api/Templates/{{templateId}}/ownerships/user/{{userId}}
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 13. GET TEMPLATES BY DEPARTMENT
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Templates/department/{{departmentId}}
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 14. GET USER DIRECT TEMPLATES
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Templates/user/{{userId}}
Authorization: Bearer {{token}}
