### ═══════════════════════════════════════════════════════════
### DEPARTMENTS WORKFLOW - Transaction System
### Base Route: api/Departments
### ═══════════════════════════════════════════════════════════

@baseUrl = https://localhost:7010
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Q2jA5PJdQpjOZ9F0wnU_2GCorgyE4UQlEIGWMeofAmQ

@departmentId = 00000000-0000-0000-0000-000000000000
@userId = 00000000-0000-0000-0000-000000000000

### ──────────────────────────────────────────────
### 1. GET DEPARTMENT TREE
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/tree
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 2. GET DEPARTMENT SUBTREE
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/{{departmentId}}/subtree
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 3. GET DEPARTMENT BY ID
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/{{departmentId}}
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 4. GET DEPARTMENT CHILDREN
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/{{departmentId}}/children
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 5. GET PATH TO ROOT
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/{{departmentId}}/path
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 6. GET PARENT DEPARTMENT
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/{{departmentId}}/parent
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 7. SEARCH DEPARTMENTS
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/search?searchTerm=Finance&level=0
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 8. GET DEPARTMENTS BY LEVEL
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/level/1
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 9. CREATE DEPARTMENT
### ──────────────────────────────────────────────
POST {{baseUrl}}/api/Departments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "New Department",
  "code": "DEPT-001",
  "description": "Department description",
  "parentDepartmentId": null,
  "headedUserId": "{{userId}}",
  "type": 0
}

### ──────────────────────────────────────────────
### 10. UPDATE DEPARTMENT
### ──────────────────────────────────────────────
PUT {{baseUrl}}/api/Departments/{{departmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Department Name",
  "code": "DEPT-UPD",
  "description": "Updated description",
  "headedUserId": "{{userId}}"
}

### ──────────────────────────────────────────────
### 11. DELETE DEPARTMENT
### ──────────────────────────────────────────────
DELETE {{baseUrl}}/api/Departments/{{departmentId}}
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 12. GET USERS IN DEPARTMENT
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/{{departmentId}}/users?includeSubDepartments=false
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 13. ASSIGN USER TO DEPARTMENT
### ──────────────────────────────────────────────
POST {{baseUrl}}/api/Departments/{{departmentId}}/assign-user
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "{{userId}}"
}

### ──────────────────────────────────────────────
### 14. ASSIGN DEPARTMENT HEAD
### ──────────────────────────────────────────────
POST {{baseUrl}}/api/Departments/{{departmentId}}/assign-head
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "{{userId}}"
}

### ──────────────────────────────────────────────
### 15. REMOVE USER FROM DEPARTMENT
### ──────────────────────────────────────────────
DELETE {{baseUrl}}/api/Departments/{{departmentId}}/remove-user/{{userId}}
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 16. GET ARCHIVE LEADERS (NEW)
### ──────────────────────────────────────────────
GET {{baseUrl}}/api/Departments/{{departmentId}}/archive-leaders
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 17. ASSIGN ARCHIVE LEADER (NEW)
### ──────────────────────────────────────────────
POST {{baseUrl}}/api/Departments/{{departmentId}}/archive-leaders/{{userId}}
Authorization: Bearer {{token}}

### ──────────────────────────────────────────────
### 18. UNASSIGN ARCHIVE LEADER (NEW)
### ──────────────────────────────────────────────
DELETE {{baseUrl}}/api/Departments/{{departmentId}}/archive-leaders/{{userId}}
Authorization: Bearer {{token}}
