{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} | {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    //"DefaultConnection": "Host=ep-round-sunset-aql1yeja.c-8.us-east-1.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=npg_PGdse1fvW6QD;SSL Mode=Require;Command Timeout=60;Pooling=true" //"DefaultConnection": "Host=ep-round-sunset-aql1yeja-pooler.c-8.us-east-1.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=npg_PGdse1fvW6QD"
    "DefaultConnection": "Host=localhost;Database=ModernPaySystemDb;Username=postgres;Password=0000"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-that-is-at-least-32-characters-long-change-this-in-production",
    "Issuer": "ModernPaySystem",
    "Audience": "ModernPaySystemUsers",
    "ExpirationMinutes": 720
  },
  "ArchiveRecordFiles": {
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".txt",
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".tiff",
      ".tif",
      ".zip",
      ".rar",
      ".7z"
    ],
    "MaxFileSize": 104857600,
    "RetryCount": 3,
    "RetryDelayMilliseconds": 250
  },
  "SemanticSearch": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "ModelName": "mxbai-embed-large",
      "TimeoutSeconds": 30
    },
    "Processing": {
      "MaxFileSizeMB": 100,
      "ChunkSize": 512,
      "ChunkOverlap": 50,
      "AllowedExtensions": [ ".docx", ".xlsx", ".txt", ".md" ]
    }
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "CollectionName": "document_chunks",
    "ApiKey": "",
    "UseTls": false
  },
  "ServerSettings": {
    "ActivateSemanticSearch": false
  },
  "Seeding": {
    "Enabled": true,
    "Environment": "Development",
    "ClearExistingData": false,
    "Quantities": {
      "RoleCount": 5,
      "PermissionCount": 20,
      "UserCount": 25,
      "SubSystemCount": 3,
      "TemplateCount": 10,
      "RequestCount": 50,
      "ResponseCount": 30,
      "AttachmentCount": 20
    }
  }
}